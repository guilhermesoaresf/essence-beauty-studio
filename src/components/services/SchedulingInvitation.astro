---
import Button from '../shared/Button.astro';
---

<section class="mx-auto flex max-w-3xl flex-col items-center py-16 text-center md:py-24">
  <h2 class="font-bodoni-moda text-4xl font-medium leading-tight text-title md:text-5xl">
    Pronta para sua transformação?
  </h2>

  <p class="mt-4 max-w-xl text-sm leading-6 text-muted-foreground md:mt-5 md:text-base md:leading-7">
    Reserve seu horário e desfrute de uma experiência de beleza exclusiva em nosso estúdio.
  </p>

  <div class="mt-8 flex w-full justify-center [&>a]:w-full [&>a]:text-center md:mt-9 md:w-auto md:[&>a]:w-auto">
    <Button text="AGENDAR AGORA" href="/scheduling" />
  </div>
</section>
