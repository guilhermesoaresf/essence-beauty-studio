---
import Button from '../shared/Button.astro';
import ServiceItem from './ServiceItem.astro';
---

<section class="mx-auto max-w-7xl py-16 md:py-24">
  <div class="grid gap-4 md:grid-cols-2 md:items-end">
    <h2 class="font-bodoni-moda text-4xl font-medium text-title md:text-5xl">
      Sobrancelhas & Expressão
    </h2>
    <p class="text-sm text-muted-foreground md:text-right md:text-base">
      Realce natural para valorizar sua expressão.
    </p>
  </div>

  <div class="mt-8 grid gap-x-20 gap-y-2 md:mt-12 md:grid-cols-2 md:gap-y-8">
    <ServiceItem
      name="Design de Sobrancelhas"
      description="Mapeamento facial e limpeza detalhada para realçar o olhar."
      duration="30 MIN"
      price="R$ 100"
      featured
    />

    <ServiceItem
      name="Henna para Sobrancelhas"
      description="Design completo com aplicação de henna para preenchimento natural."
      duration="45 MIN"
      price="R$ 140"
    />

    <ServiceItem
      name="Brow Lamination"
      description="Técnica para sobrancelhas mais cheias, alinhadas e com efeito de passarela."
      duration="60 MIN"
      price="R$ 250"
    />
  </div>

  <div class="mt-8 flex justify-center [&>a]:w-full [&>a]:text-center md:mt-12 md:[&>a]:w-auto">
    <Button text="AGENDAR SOBRANCELHAS" href="/scheduling" />
  </div>
</section>
