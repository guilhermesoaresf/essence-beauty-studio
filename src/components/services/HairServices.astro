---
import Button from '../shared/Button.astro';
import ServiceItem from './ServiceItem.astro';
---

<section class="mx-auto max-w-7xl py-16 md:py-24">
  <div class="grid gap-4 md:grid-cols-2 md:items-end">
    <h2 class="font-bodoni-moda text-4xl font-medium text-title md:text-5xl">
      Cabelo & Estilo
    </h2>
    <p class="text-sm text-muted-foreground md:text-right md:text-base">
      Cortes, coloração e tratamentos exclusivos.
    </p>
  </div>

  <div class="mt-8 grid gap-x-20 gap-y-2 md:mt-12 md:grid-cols-2 md:gap-y-8">
    <ServiceItem
      name="Corte Feminino"
      description="Corte personalizado com visagismo, lavagem relaxante e finalização."
      duration="60 MIN"
      price="R$ 280"
    />

    <ServiceItem
      name="Escova"
      description="Modelagem profissional com produtos premium para brilho e durabilidade."
      duration="45 MIN"
      price="R$ 150"
    />

    <ServiceItem
      name="Hidratação Capilar"
      description="Banho de nutrientes para devolver vitalidade e maciez aos fios."
      duration="40 MIN"
      price="R$ 180"
      featured
    />

    <ServiceItem
      name="Balayage Editorial"
      description="Iluminação estratégica para um efeito natural beijado pelo sol."
      duration="240 MIN"
      price="R$ 750"
    />
  </div>

  <div class="mt-8 flex justify-center [&>a]:w-full [&>a]:text-center md:mt-12 md:[&>a]:w-auto">
    <Button text="AGENDAR CABELO" href="/scheduling" />
  </div>
</section>
