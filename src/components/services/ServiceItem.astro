---
interface Props {
  name: string;
  description: string;
  duration: string;
  price: string;
  featured?: boolean;
}

const {
  name,
  description,
  duration,
  price,
  featured = false,
} = Astro.props;
---

<article class:list={[
  'relative p-4 md:p-6',
  featured && 'bg-card pt-10 shadow-sm md:pt-6',
]}>
  {featured && (
    <span class="absolute right-0 top-0 bg-primary px-3 py-1 text-[10px] font-semibold text-white md:px-4 md:text-xs">
      POPULAR
    </span>
  )}

  <div class="flex items-start justify-between gap-4 md:gap-6">
    <h3 class="font-bodoni-moda text-2xl font-medium leading-tight text-title md:text-3xl">
      {name}
    </h3>
    <p class="shrink-0 pt-1 text-sm font-semibold text-foreground md:pt-2 md:text-base">{price}</p>
  </div>

  <p class="mt-2 text-sm leading-6 text-muted-foreground md:text-base">{description}</p>
  <p class="mt-3 text-[11px] font-semibold tracking-wider text-primary md:text-xs">{duration}</p>
</article>
