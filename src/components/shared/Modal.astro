---
import { X } from '@lucide/astro';
---

<div
  id="modal-overlay"
  class="fixed inset-0 z-400 hidden items-center justify-center bg-black/50 p-5"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="modal-title"
  aria-describedby="modal-message"
>
  <div class="relative w-full max-w-md rounded-xl border border-border bg-card p-6 shadow-xl">
    <button
      id="close-modal"
      type="button"
      class="absolute right-3 top-3 cursor-pointer rounded-full p-2 text-gray-500 hover:bg-black/5 hover:text-black"
      aria-label="Fechar diálogo"
    >
      <X aria-hidden="true" />
    </button>
    <h2 id="modal-title" class="mb-2 pr-10 text-xl font-semibold"></h2>
    <p id="modal-message" class="mb-6 text-sm leading-6 text-muted-foreground"></p>
    <button
      id="confirm-modal"
      type="button"
      class="cursor-pointer rounded-full bg-primary px-5 py-2 text-white hover:bg-primary/90"
    >
      Entendi
    </button>
  </div>
</div>
