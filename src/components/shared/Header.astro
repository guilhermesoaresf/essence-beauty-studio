---
import { Menu, X } from '@lucide/astro';
import Button from './Button.astro';

const { pathname } = Astro.url;

const links = [
  { href: '/', label: 'O STUDIO' },
  { href: '/services', label: 'SERVIÇOS' },
  { href: '/scheduling', label: 'AGENDAMENTO' },
];
---

<header class="fixed top-0 z-100 hidden h-20 w-full items-center justify-between border-b border-border/30 bg-background px-20 md:flex">
  <a href="/" class="font-bodoni-moda text-3xl font-medium tracking-[-1.6px]">Essence</a>
  <nav aria-label="Navegação principal">
    <ul class="flex items-center gap-12 text-sm font-semibold text-muted-foreground">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={pathname === href ? 'page' : undefined}
            class:list={[
              'border-b border-transparent pb-1 transition-all hover:border-black hover:text-black',
              pathname === href && 'border-black text-black',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <Button href="/scheduling" text="RESERVA" />
</header>

<header class="fixed top-0 z-100 flex h-20 w-full items-center border-b border-border/30 bg-background px-5 md:hidden">
  <button
    id="open-mobile-menu"
    type="button"
    class="rounded-full p-2 hover:bg-black/5"
    aria-label="Abrir menu"
    aria-controls="mobile-menu"
    aria-expanded="false"
  >
    <Menu aria-hidden="true" />
  </button>

  <a href="/" class="absolute left-1/2 -translate-x-1/2 font-bodoni-moda text-3xl font-semibold tracking-[-1.6px]">
    ESSENCE
  </a>

  <aside
    id="mobile-menu"
    class="fixed inset-y-0 left-0 z-200 w-72 -translate-x-full bg-background p-6 shadow-2xl transition-transform duration-300"
    aria-hidden="true"
    inert
  >
    <div class="mb-12 flex items-center justify-between">
      <span class="font-bodoni-moda text-2xl font-semibold">Essence</span>
      <button id="close-mobile-menu" type="button" class="rounded-full p-2 hover:bg-black/5" aria-label="Fechar menu">
        <X aria-hidden="true" />
      </button>
    </div>
    <nav aria-label="Navegação móvel">
      <ul class="space-y-6 text-sm font-semibold tracking-wider text-muted-foreground">
        {links.map(({ href, label }) => (
          <li><a href={href} class="block py-2 hover:text-black">{label}</a></li>
        ))}
      </ul>
    </nav>
  </aside>
  <div id="mobile-menu-backdrop" class="fixed inset-0 z-150 hidden bg-black/35" aria-hidden="true"></div>
</header>

<script>
  function setMobileMenuOpen(isOpen: boolean) {
    const menu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const openButton = document.getElementById('open-mobile-menu');
    const closeButton = document.getElementById('close-mobile-menu');

    if (!menu || !backdrop || !openButton || !closeButton) return;

    menu.classList.toggle('-translate-x-full', !isOpen);
    menu.toggleAttribute('inert', !isOpen);
    menu.setAttribute('aria-hidden', String(!isOpen));
    openButton.setAttribute('aria-expanded', String(isOpen));
    backdrop.classList.toggle('hidden', !isOpen);
    if (isOpen) closeButton.focus();
  }

  function initMobileMenu() {
    if (document.documentElement.dataset.mobileMenuReady) return;
    document.documentElement.dataset.mobileMenuReady = 'true';

    document.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (target.closest('#open-mobile-menu')) setMobileMenuOpen(true);
      if (target.closest('#close-mobile-menu, #mobile-menu-backdrop, #mobile-menu a')) setMobileMenuOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMobileMenuOpen(false);
    });
  }

  document.addEventListener('astro:page-load', initMobileMenu);
</script>
