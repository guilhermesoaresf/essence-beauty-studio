---
import type { Icon } from '@lucide/astro';

interface Props {
  text: string;
  IconComponent?: typeof Icon;
  href?: string;
  textColor?: string;
  bgColor?: string;
  outlineColor?: string;
  bgColorHover?: string;
  target?: string;
}

const {
  text,
  IconComponent,
  href,
  textColor="text-white",
  bgColor="bg-primary",
  outlineColor,
  bgColorHover='hover:bg-primary/90',
  target="_self",
} = Astro.props;

const rel = target === '_blank' ? 'noreferrer' : undefined;
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={[
    'inline-flex items-center justify-center rounded-full px-8 py-3 text-sm font-semibold uppercase transition-colors duration-200',
    IconComponent && 'gap-2',
    textColor,
    bgColor,
    outlineColor && `outline ${outlineColor}`,
    bgColorHover,
  ]}
>
  {IconComponent && <IconComponent size={20} />}
  <span>{text}</span>
</a>
